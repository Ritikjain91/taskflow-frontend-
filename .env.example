# Leave unset for local dev — requests go to the relative '/api' path,
# which vite.config.ts proxies to http://localhost:4000.
#
# In production (e.g. Vercel), set this to your deployed backend's URL
# with /api on the end:
# VITE_API_URL=https://taskflow-backend-027e.onrender.com/api
VITE_API_URL=https://taskflow-backend-027e.onrender.com/api
